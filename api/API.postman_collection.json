	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"// Generar fecha de inicio (desde hoy hasta 30 días posteriores)\r",
					"const today = new Date();\r",
					"const startDate = new Date(today.getTime() + Math.random() * 30 * 24 * 60 * 60 * 1000);\r",
					"\r",
					"// Generar fecha de fin (desde 31 días después de hoy hasta 365 días)\r",
					"const minEndDate = new Date(today.getTime() + 31 * 24 * 60 * 60 * 1000);\r",
					"const maxEndDate = new Date(today.getTime() + 365 * 24 * 60 * 60 * 1000);\r",
					"const endDate = new Date(minEndDate.getTime() + Math.random() * (maxEndDate.getTime() - minEndDate.getTime()));\r",
					"\r",
					"// Formatear fechas (ISO format)\r",
					"const fechaInicio = startDate.toISOString().split('T')[0]; // YYYY-MM-DD\r",
					"const fechaFin = endDate.toISOString().split('T')[0];\r",
					"\r",
					"// Guardar en variables de entorno\r",
					"pm.environment.set(\"fecha_inicio\", fechaInicio);\r",
					"pm.environment.set(\"fecha_fin\", fechaFin);"
				]
			}
		},
